# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

# NPM package location
node_modules/

# Build output
build/

# Cordova folders
platforms/
plugins/

# OS X build output
project.xcworkspace/
xcuserdata/

# Coverage data
coverage

# VS Code
typings/
.vscode/**/
.vscode/plugins.json

# Visual Studio
.vs/

# Local environment variables
.secrets.json
.env
.env.*
!.env.example
*.key
*.pem
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.provisionprofile

# OS Meta data files
Thumbs.db
.DS_Store
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

# Editor / Log data
*~
*.sw[mnpcod]
*.log
*.tmp
*.tmp.*
log.txt
*.sublime-project
*.sublime-workspace
npm-debug.log*

# Firebase
.firebase

# Phase-1 demo build output
demo/dist/

# Phase-1 app production build output
/dist/
/dist-server/

# companion local database
*.db
*.db-*
/data/

# Local agent runtime and credentials
.empirica/
.abc-state/
.env
.env.local
.env.*.local

# Discoverable project-owned workflow files
!/.agent-workflow.json
!/.claude/
/.claude/*
!/.claude/commands/
/.claude/commands/*
!/.claude/commands/abc.md
!/.claude/commands/intake.md
!/.claude/skills/
/.claude/skills/*
!/.agents/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/skills/
!/scripts/
!/scripts/agent-workflow.py
!/docs/
!/docs/agent-workflow.md
!/skills/opensprinkler-app-abc/
!/skills/opensprinkler-app-abc/SKILL.md
!/.agents/skills/opensprinkler-app-abc
!/.claude/skills/opensprinkler-app-abc
!/skills/opensprinkler-app-intake/
!/skills/opensprinkler-app-intake/SKILL.md
!/.agents/skills/opensprinkler-app-intake
!/.claude/skills/opensprinkler-app-intake
!/scripts/test_agent_workflow.py

# Machine-local agent credentials and generated Python state
.claude/settings.local.json
.claude/agent-memory/
__pycache__/

# Admit workflow verification without narrowing existing GitHub configuration rules
!/.github/
!/.github/workflows/
!/.github/workflows/agent-workflow.yml

# Isolated workflow parser/test environment
/.workflow-test-env/
!/scripts/requirements-agent-workflow.txt
